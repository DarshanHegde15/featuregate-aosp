From: Darshan Hegde <darshanhegde1156@gmail.com>
Date: Fri, 6 Nov 2026 17:55:28 +0530
Subject: [PATCH 13/13] FeatureGate: ongoing notification listing restricted
 features

RestrictionNotifier keeps one low-importance ongoing notification
(updated in place) with the blocked features, posted for all users
after PHASE_BOOT_COMPLETED from the service handler thread.

Change-Id: I87d4cb0b5452d13e162370bc2a416e541a66dda1
---
 .../featuregate/FeatureGateService.java       | 26 ++++++++
 .../featuregate/RestrictionNotifier.java      | 61 +++++++++++++++++++
 2 files changed, 87 insertions(+)
 create mode 100644 services/core/java/com/android/server/featuregate/RestrictionNotifier.java

diff --git a/services/core/java/com/android/server/featuregate/FeatureGateService.java b/services/core/java/com/android/server/featuregate/FeatureGateService.java
index 381488b30a85..fd50fdc9eb37 100644
--- a/services/core/java/com/android/server/featuregate/FeatureGateService.java
+++ b/services/core/java/com/android/server/featuregate/FeatureGateService.java
@@ -73,6 +73,8 @@ public final class FeatureGateService extends SystemService {
     private final FeatureGateStore mStore = new FeatureGateStore();
     private final Handler mIoHandler = IoThread.getHandler();
     private final Runnable mWriteRunnable = this::writeRulesNow;
+    private RestrictionNotifier mRestrictionNotifier;
+    private Boolean mBootCompleted;
 
     private final BroadcastReceiver mBatteryReceiver = new BroadcastReceiver() {
         @Override
@@ -91,6 +93,7 @@ public final class FeatureGateService extends SystemService {
         mHandlerThread.start();
         mHandler = new Handler(mHandlerThread.getLooper());
         mNotifier = new BlockedNotifier(context);
+        mRestrictionNotifier = new RestrictionNotifier(context);
     }
 
     @Override
@@ -136,6 +139,10 @@ public final class FeatureGateService extends SystemService {
     public void onBootPhase(int phase) {
         if (phase == PHASE_SYSTEM_SERVICES_READY) {
             registerBatteryReceiver();
+            mHandler.post(() -> {
+                mBootCompleted = true;
+                updateRestrictionNotification();
+            });
         }
     }
 
@@ -252,6 +259,7 @@ public final class FeatureGateService extends SystemService {
         } finally {
             mListeners.finishBroadcast();
         }
+        updateRestrictionNotification();
     }
 
     // Runs on mHandler, without mLock
@@ -305,6 +313,24 @@ public final class FeatureGateService extends SystemService {
         mStore.writeRules(snapshot);
     }
 
+    // Runs on mHandler. Posts, updates or cancels the ongoing notification.
+    private void updateRestrictionNotification() {
+        if (!mBootCompleted) {
+            return;
+        }
+
+        final ArraySet<String> blocked = new ArraySet<>();
+        synchronized (mLock) {
+            for (FeatureRule rule : mRules.values()) {
+                if (!isAllowedLocked(rule.getFeatureId())) {
+                    blocked.add(rule.getFeatureId());
+                }
+            }
+        }
+
+        mRestrictionNotifier.update(blocked); // Outside the lock: It's a binder call to NMS
+    }
+
     private final class LocalService extends FeatureGateInternal {
         @Override
         public boolean isFeatureAllowed(String featureId) {
