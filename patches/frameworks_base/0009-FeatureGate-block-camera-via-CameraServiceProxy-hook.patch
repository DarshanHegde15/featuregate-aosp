From b9435e6e09c98078bd23bfe8e31f0f8f3f499f58 Mon Sep 17 00:00:00 2001
From: Darshan Hegde <darshanhegde1156@gmail.com>
Date: Sun, 1 Nov 2026 13:52:16 +0530
Subject: [PATCH 09/13] FeatureGate: block camera via CameraServiceProxy hook

CameraServiceProxy.isCameraDisabled() (called by cameraserver on every
camera open) now also asks FeatureGateInternal; when camera is blocked by a
battery rule it returns true, cameraserver refuses the open as for a
device-policy disable, and FeatureGate shows its blocked toast.
CameraEnforcer records state for logs and dumpsys (preventive only;
already-open cameras are not closed).

Change-Id: I6e9c6e6ae32ba82fd5607c6dbe4dc6c9bff51f3a
---
 .../server/camera/CameraServiceProxy.java     |  8 +++
 .../server/featuregate/CameraEnforcer.java    | 55 +++++++++++++++++++
 .../featuregate/FeatureGateService.java       |  1 +
 3 files changed, 64 insertions(+)
 create mode 100644 services/core/java/com/android/server/featuregate/CameraEnforcer.java

diff --git a/services/core/java/com/android/server/camera/CameraServiceProxy.java b/services/core/java/com/android/server/camera/CameraServiceProxy.java
index 05fc6bc869ca..bd1066465ef7 100644
--- a/services/core/java/com/android/server/camera/CameraServiceProxy.java
+++ b/services/core/java/com/android/server/camera/CameraServiceProxy.java
@@ -108,6 +108,9 @@ import java.util.Set;
 import java.util.concurrent.ScheduledThreadPoolExecutor;
 import java.util.concurrent.TimeUnit;
 
+import android.app.featuregate.FeatureGateManager;
+import com.android.server.featuregate.FeatureGateInternal;
+
 /**
  * CameraServiceProxy is the system_server analog to the camera service running in cameraserver.
  *
@@ -868,6 +871,11 @@ public class CameraServiceProxy extends SystemService
 
         @Override
         public boolean isCameraDisabled(int userId) {
+            final FeatureGateInternal featureGate = LocalServices.getService(FeatureGateInternal.class);
+            if(featureGate != null && !featureGate.isFeatureAllowed(FeatureGateManager.FEATURE_CAMERA)) {
+                featureGate.notifyBlocked(FeatureGateManager.FEATURE_CAMERA);
+                return true;
+            }
             if (Binder.getCallingUid() != Process.CAMERASERVER_UID) {
                 Slog.e(TAG, "Calling UID: " + Binder.getCallingUid()
                         + " doesn't match expected camera service UID!");
