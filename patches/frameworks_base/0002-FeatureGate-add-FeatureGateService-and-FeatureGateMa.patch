+package android.app.featuregate;
+
+import android.annotation.NonNull;
+import android.content.Context;
+import android.app.featuregate.IFeatureGateManager;
+import android.os.RemoteException;
+
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Client API for FeatureGateService.
+ * Get it with {@code context.getSystemService(FeatureGateManager.class)}.
+ * @hide
+ */
+public class FeatureGateManager {
+        private final Context mContext;
+        private final IFeatureGateManager mService;
+
+    /** @hide */
+    public FeatureGateManager(@NonNull Context context, @NonNull IFeatureGateManager service) {
+        mContext = context;
+        mService = service;
+    }
+
+    /** Returns true if the feature is allowed right now. */
+    public boolean isFeatureAllowed(@NonNull String featureId) {
+        Objects.requireNonNull(featureId, "featureId");
+        try {
+            return mService.isFeatureAllowed(featureId);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Returns all current rules. */
+    @NonNull
+    public List<FeatureRule> getRules() {
+        try {
+            return mService.getRules();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Adds or replaces a rule. Admin only. */
+    public void setRule(@NonNull FeatureRule rule) {
+        Objects.requireNonNull(rule, "rule");
+        try {
+            mService.setRule(rule);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /** Removes the rule for a feature. Admin only. */
+    public void removeRule(@NonNull String featureId) {
+        Objects.requireNonNull(featureId, "featureId");
+        try {
+            mService.removeRule(featureId);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+}
diff --git a/services/core/java/com/android/server/featuregate/FeatureGateService.java b/services/core/java/com/android/server/featuregate/FeatureGateService.java
new file mode 100644
index 000000000000..8e91572ee11a
--- /dev/null
+++ b/services/core/java/com/android/server/featuregate/FeatureGateService.java
@@ -0,0 +1,116 @@
+package com.android.server.featuregate;
+
+import android.app.featuregate.FeatureRule;
+import android.app.featuregate.IFeatureGateListener;
+import android.app.featuregate.IFeatureGateManager;
+import android.content.Context;
+import android.os.Binder;
+import android.os.Process;
+import android.os.RemoteCallbackList;
+import android.util.ArrayMap;
+import android.util.Slog;
+
+import com.android.internal.annotations.GuardedBy;
+import com.android.server.SystemService;
+
+import java.util.ArrayList;
+import java.util.List;
+public final class FeatureGateService extends SystemService {
+    private static final String TAG = "FeatureGateService";
+
+    private final Object mLock = new Object();
+
+    /** featureId -> rule. A feature with no rule is always allowed. */
+    @GuardedBy("mLock")
+    private final ArrayMap<String, FeatureRule> mRules = new ArrayMap<>();
+
+    //Battery state. Real values arrive in Battery receiver.
+    @GuardedBy("mLock")
+    private int mBatteryPercent = 100;
+    @GuardedBy("mLock")
+    boolean mCharging = false;
+
+    private final BinderService mBinderService = new BinderService();    /** App listeners. Dead clients are removed automatically */
+    private final RemoteCallbackList<IFeatureGateListener> mListeners = new RemoteCallbackList<>();
+
+    public FeatureGateService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(Context.FEATURE_GATE_SERVICE, mBinderService);
+        Slog.i(TAG, "FeatureGateService started");
+    }
+
+    @GuardedBy("mLock")
+    private boolean isAllowedLocked(String featureId) {
+        final FeatureRule rule = mRules.get(featureId);
+        if (rule == null) {
+            Slog.i(TAG, "isAllowedLocked: Empty feature rule");
+            return true;
+        }
+        Slog.i(TAG, "isAllowedLocked: Feature rule found, checking ....");
+        return mBatteryPercent >= rule.getMinBatteryPercent() || (rule.getAllowWhenCharging() && mCharging);
+    }
+
+    /** Temporary admin checks until MANAGE_FEATURE_GATES permssion exists */
+    private static void enforceAdminCaller() {
+        final int uid = Binder.getCallingUid();
+        if(uid != Process.SYSTEM_UID && uid != Process.SHELL_UID && uid != Process.ROOT_UID) { throw new SecurityException("Uid" + uid + "man not change feature rules"); }
+    }
+
+    private final class BinderService extends IFeatureGateManager.Stub {
+        @Override
+        public boolean isFeatureAllowed(String featureId) {
+            if(featureId == null) throw new IllegalArgumentException("featureId is null");
+
+            synchronized(mLock) {
+                boolean isAllowed = isAllowedLocked(featureId);
+                Slog.i(TAG,"isFeatureAllowed: " + isAllowed);
+                return isAllowed;
+            }
+        }
+
+        @Override
+        public List<FeatureRule> getRules() {
+            synchronized (mLock) {
+                return new ArrayList<>(mRules.values());
+            }
+        }
+
+        @Override
+        public void setRule(FeatureRule rule) {
+            enforceAdminCaller();
+            if(rule == null || rule.getFeatureId() == null || rule.getFeatureId().isEmpty() || rule.getMinBatteryPercent() < 0 || rule.getMinBatteryPercent() > 100) { throw new IllegalArgumentException("invalid rule: " + rule); }
+        }
+
+        @Override // Binder call: admin only
+        public void removeRule(String featureId) {
+            enforceAdminCaller();
+            if (featureId == null) {
+                throw new IllegalArgumentException("featureId is null");
+            }
+            synchronized (mLock) {
+                mRules.remove(featureId);
+            }
+            Slog.i(TAG, "removeRule " + featureId + " by uid " + Binder.getCallingUid());
+        }
+
+        @Override // Binder call
+        public void registerListener(IFeatureGateListener listener) {
+            if (listener == null) {
+                throw new IllegalArgumentException("listener is null");
+            }
+            mListeners.register(listener);
+        }
+
+        @Override // Binder call
+        public void unregisterListener(IFeatureGateListener listener) {
+            if (listener == null) {
+                throw new IllegalArgumentException("listener is null");
+            }
+            mListeners.unregister(listener);
+        }
+    }
+}
