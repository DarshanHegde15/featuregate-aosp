Date: Wed, 28 Oct 2026 19:57:02 +0530
Subject: [PATCH 06/13] FeatureGate: SystemUiEnforcer blocks navigation buttons

Uses IStatusBarService.disable() with FeatureGate's own token (same
mechanism as lock task mode), so its restrictions merge with others.
Handles nav_back, nav_home, nav_recents and nav_all.

Change-Id: Ib87425abcc404ca4dc64f586d0800c3bc7400757
---
 .../featuregate/FeatureGateService.java       |   1 +
 .../server/featuregate/SystemUiEnforcer.java  | 106 ++++++++++++++++++
 2 files changed, 107 insertions(+)
 create mode 100644 services/core/java/com/android/server/featuregate/SystemUiEnforcer.java

diff --git a/services/core/java/com/android/server/featuregate/FeatureGateService.java b/services/core/java/com/android/server/featuregate/FeatureGateService.java
index 48492eb849aa..2102cfc15530 100644
--- a/services/core/java/com/android/server/featuregate/FeatureGateService.java
+++ b/services/core/java/com/android/server/featuregate/FeatureGateService.java
@@ -76,6 +76,7 @@ public final class FeatureGateService extends SystemService {
 
     public FeatureGateService(Context context) {
         super(context);
+        registerEnforcer(new SystemUiEnforcer(context));
         mCatalog = new FeatureCatalog(context);
         mHandlerThread = new ServiceThread(TAG, Process.THREAD_PRIORITY_BACKGROUND,
                 false /* allowIo */);
diff --git a/services/core/java/com/android/server/featuregate/SystemUiEnforcer.java b/services/core/java/com/android/server/featuregate/SystemUiEnforcer.java
new file mode 100644
index 000000000000..b37ca48d9dae
